@techreport{fordPreparing2026,
  title = {Preparing for the {{Exceptional}}: {{Extreme Meteorological Years}} in {{Energy System Planning}}},
  shorttitle = {Preparing for the {{Exceptional}}},
  author = {Ford, Victoria and Roman, Jacola and Machuca, Vanessa and Ordonez, Ana and Keeney, Nicole and Schroeder, Neil and Doherty, Owen},
  year = 2026,
  month = jul,
  institution = {Zenodo},
  doi = {10.5281/ZENODO.21401751},
  url = {https://zenodo.org/doi/10.5281/zenodo.21401751},
  urldate = {2026-07-18},
  abstract = {Typical Meteorological Year (TMY) climate profiles remain foundational inputs to building and~power system models, providing standardized hourly weather conditions for simulating~energy demand and system performance under strain. However, extreme weather events are~increasingly shaping the design and operational needs of electricity systems more so~than ``typical'' conditions. Traditional TMYs are designed around median historical conditions~and therefore suppress the types of extreme events that increasingly drive peak demand, grid~strain, outage risk, and infrastructure vulnerability, such as the August 2020 Heatwave. As~climate risks intensify, energy planners and decision-makers require climate profiles that better represent the range, timing, and persistence of extreme conditions without introducing~unnecessary overdesign or cost.~To bridge the gap between energy demand planning needs and practical extremescharacterization, Cal-Adapt has developed scientifically robust, stakeholder-vetted Extreme~Meteorological Year (XMY) climate profiles designed specifically for a range of energy-sector~applications. This report details the industry motivation for Cal-Adapt's standardized approaches for extreme climate profiles, their use cases and limitations, and recommendations for use.~ For more information, see: https://cal-adapt.org/},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {english}
}

@article{freitasCoProducing2026,
  title = {Co-{{Producing Climate Services}} for {{California}}'s {{Energy Sector}}},
  author = {Freitas, N. L. and Jagannathan, K. and Bui, J. and Ford, V. L. and Krantz, W. and Buddhavarapu, S. and Chen, C. and Conrad-Saydah, A. and Koenig, M. and Doherty, O. and Jones, A. D.},
  year = 2026,
  month = jul,
  journal = {Earth's Future},
  volume = {14},
  number = {7},
  pages = {e2025EF005959},
  issn = {2328-4277, 2328-4277},
  doi = {10.1029/2025EF005959},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2025EF005959},
  urldate = {2026-07-31},
  abstract = {Abstract             Climate change has made the energy sector's provision of safe, cost-effective, and reliable services more difficult. Integrating climate data into decision making can improve the sector's ability to anticipate and navigate these risks. However, despite the proliferation of climate data and services, their practical use remains low. A rich literature examines the existence of barriers to climate data use in planning and adaptation, but few studies trace barriers back to their often invisible organizational and institutional factors. Here, we describe how we identified and addressed these factors during the co-production of the Cal-Adapt: Analytics Engine, a state-level climate services platform for California's energy sector. Through three~years of iterative engagements with scientists, practitioners, and decision makers, we identified four underlying root causes that inhibited climate data use in the sector: (a) institutional legacies within decision-making processes; (b) limited experience with iterative, engaged practices within scientific processes; (c) rigidly constructed and highly tailored climate services; and (d) a lack of clarity on how climate guidance should be developed. We corroborate existing research that emphasizes the need for data to fit decision contexts but also highlight the potential drawbacks of over-tailoring data to the current moment. Flexible climate services are needed that recognize the evolving nature of climate science, increasing practitioner expertise, and advances in climate policy. Our research demonstrates how a highly interactive, state-level co-production process helped overcome some of these issues to create more actionable climate data, tools, and guidance.           ,              Plain Language Summary             Climate change affects major aspects of energy system planning and operations. Although climate data can help guide decisions to address these challenges, its use in adaptation planning has remained limited. Our research examines the collaborative development of a climate services platform for California's energy sector---the Cal-Adapt: Analytics Engine. By working directly with scientists, practitioners, and decision makers, we surface four root causes that inhibited climate data use in the sector. We identify how and why they occurred and provide examples of how collaborative approaches to climate services development can improve the usability of science within energy sector planning.           ,              Key Points                                                                This paper reviews 3~years of iterative engagements to co-produce a state-level climate services platform                                                     We surface four root causes that limited the usability of climate data in the California energy sector                                                     We identify strategies to help overcome barriers to climate data use and accelerate the uptake of climate information in decision making},
  langid = {english}
}

